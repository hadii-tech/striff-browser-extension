# IDE
.vscode/
.idea/

# Test artifacts
test/.pw-profile/
.pw-profile/
test/.pw-*/
test/.pw-profile-*/
test-results/
dist/

# Scratch / probe scripts and tool run artifacts
.tmp-*
.claude/scheduled_tasks.lock
.claude/**/.temp-execution-*.js

# Node
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Build
*.zip
build/
dist/

# Local config (test-only)
html/config-local-test.json

# Dev screenshots
preview-menu.png
*.png
!icons/*.png

# Playwright/Chrome profiles created by test runs. The three .pw-profile patterns
# above miss a doubled test/test/ path, which is how 19MB of browser profile --
# including Chrome's (empty) Cookies and Login Data stores -- reached a public repo.
test/test/
**/.pw-profile*/
